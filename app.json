{
  "expo": {
    "name": "CinéMax",
    "slug": "cinemax-mobile",
    "version": "1.1.5",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "cinemax",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cinemax.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cinemax.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-video",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": null,
          "color": "#09090b"
        }
      ],
      "./plugins/withCmakeObjectPathMax"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cfc488b3-4282-4448-90be-4ba96d59234c"
      }
    },
    "owner": "tassirou"
  }
}
