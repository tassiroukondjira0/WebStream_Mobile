{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-native",
    "lib": ["es2021"],
    "moduleResolution": "node",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "es2021",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "app.json", "expo-env.d.ts"],
  "exclude": ["node_modules", "android", "ios", "build", "dist"]
}
